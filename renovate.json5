{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":gitSignOff",
  ],
  "labels": ["renovate"],
  "prConcurrentLimit": 2,
  "ignorePaths": ["**/vendor/**"],
  // ignore everything except those that are white-listed
  "packageRules": [
    // Kubernetes rules copied from kedify/github-meta/kubernetes-versions.json.
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "rancher/k3s"
      ],
      "versioning": "regex:^v(?<major>1)\\.(?<compatibility>[0-9]+)\\.(?<patch>[0-9]+)-k3s(?<build>[0-9]+)$",
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "kindest/node"
      ],
      "versioning": "regex:^v(?<major>1)\\.(?<compatibility>[0-9]+)\\.(?<patch>[0-9]+)$",
      "pinDigests": true,
      "automerge": false
    },
    {
      "packagePatterns": ["*"],
      "enabled": false,
    },
    {
      "packageNames": [
        "ghcr.io/kedify/charts/otel-add-on",
      ],
      "labels": ["skip-ci", "renovate"],
      "enabled": true,
    },
    {
      "packageNames": [
        "open-telemetry/opentelemetry-helm-charts",
      ],
      "labels": ["skip-ci", "renovate"],
      "enabled": true,
    },
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["rancher/k3s"],
      "matchFileNames": ["e2e-tests/kubernetes-versions.json"],
      "enabled": true,
      "pinDigests": true,
      "labels": ["dependencies", "kubernetes"],
    },
  ],
  "regexManagers": [
    // Shared managers, in this file's existing regexManagers format.
    {
      "fileMatch": [
        "(^|/)(kedify-)?kubernetes-versions\\.json$"
      ],
      "matchStrings": [
        "\"(?<depName>rancher/k3s|kindest/node):(?<currentValue>v1\\.[0-9]+\\.[0-9]+(?:-k3s[0-9]+)?)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": [
        "^\\.github/workflows/.*\\.ya?ml$"
      ],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=kubernetes-sigs/kind\\s+version: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      // bump helm chart version if there is a release
      "fileMatch": [
        "(^|/)README.md$",
        "(^|/)examples/metric-pu(ll|sh)/(README.md|setup.sh)$",
        "(^|/)examples/dapr/(README.md|setup.sh)$",
        "(^|/)examples/otel-operator/setup.sh$",
        "(^|/)examples/pipelines-tls/setup.sh$",
        "(^|/)examples/cloudwatch-metric-stream/(README.md|setup.sh)$",
        "(^|/)examples/vllm/(dcgm|scraping-router|sidecar)/setup.sh$",
        "(^|/)helmchart/otel-add-on/README.md$",
        "(^|/)helmchart/otel-add-on/_helm-docs-README.md.gotmpl$",
      ],
      "datasourceTemplate": "docker",
      "depTypeTemplate": "helm_release",
      "depNameTemplate": "ghcr.io/kedify/charts/otel-add-on",
      "extractVersionTemplate": "^(?<version>.*)$",
      "matchStrings": [
        ".* oci://ghcr.io/kedify/charts/otel-add-on \\s*--version=(?<currentValue>\\S+).*\n",
      ],
    },

    // bump helm chart version of opentelemetry-collector if there is a release
    {
      "fileMatch": [
        "(^|/)helmchart/otel-add-on/README.md$",
        "(^|/)helmchart/otel-add-on/values.yaml$",
        "(^|/)helmchart/otel-add-on/values.schema.json$",
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "open-telemetry/opentelemetry-helm-charts",
      "extractVersionTemplate": "^opentelemetry-collector-(?<version>.*)$",
      "matchStrings": [
        ".*/(tree|tags)/opentelemetry-collector-(?<currentValue>[^/]+).*\n",
      ],
    },
    {
      "fileMatch": [
        "(^|/)helmchart/otel-add-on/Chart.yaml$"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "open-telemetry/opentelemetry-helm-charts",
      "extractVersionTemplate": "^opentelemetry-collector-(?<version>.*)$",
      "matchStrings": [
        ".*opentelemetry-collector\n.*/opentelemetry-helm-charts\n\\s+version:\\s+(?<currentValue>[^\\S]+).*\n",
      ],
    },

    // bump helm chart version of opentelemetry-operator if there is a release
    {
      "fileMatch": [
        "(^|/)helmchart/otel-add-on/README.md$",
        "(^|/)helmchart/otel-add-on/values.yaml$"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "open-telemetry/opentelemetry-helm-charts",
      "extractVersionTemplate": "^opentelemetry-operator-(?<version>.*)$",
      "matchStrings": [
        ".*/(tree|tags)/opentelemetry-operator-(?<currentValue>[^/]+).*\n",
      ],
    },
    {
      "fileMatch": [
        "(^|/)helmchart/otel-add-on/Chart.yaml$"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "open-telemetry/opentelemetry-helm-charts",
      "extractVersionTemplate": "^opentelemetry-operator-(?<version>.*)$",
      "matchStrings": [
        ".*opentelemetry-operator\n.*/opentelemetry-helm-charts\n\\s+version:\\s+(?<currentValue>[^\\S]+).*\n",
      ],
    }
  ],
  "reviewers": ["team:all"],
  "prBodyNotes": [
    "Bump some versions we have inside our code",
  ],
}
